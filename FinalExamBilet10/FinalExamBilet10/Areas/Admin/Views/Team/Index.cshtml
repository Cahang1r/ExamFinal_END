@model IEnumerable<Team>

<div class="container" style="margin-left:300px">
    <a asp-action="Create" class="btn btn-success">Create</a>
    <main>
        <table class="table">
            <thead>
                <tr>
                    
                    <th scope="col">Image</th>
                    <th scope="col">Name</th>
                    <th scope="col">Job</th>
                    <th scope="col">Description</th>
                    <th scope="col">Operations</th>
                </tr>
            </thead>
            <tbody>
               @foreach (var item in Model)
                {
                    <tr>
                    
                        <td>
                            <img src="~/assets/images/@item.Image"  height="80px" width="80px"/>
                        </td>
                        <td>@item.Name</td>
                        <td>@item.Job</td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-action="Update" asp-route-id="@item.Id"     class="btn btn-warning">Edit</a>
                            <a asp-action="Detail" asp-route-id="@item.Id" class="btn btn-info">Detail</a>
                                <form method="post" asp-action="Delete" asp-route-id="@item.Id"   >
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                        </td>
                    </tr>
                }
            
            </tbody>
        </table>
    </main>
</div>