@using FinalExamBilet10.ViewModels.Account
@{
    Layout = null;
}
@model RegisterVm
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
<div class="container">
    <form method="post">
        <div class="mb-3">
            <label asp-for="UserName" class="form-label"></label>
            <input asp-for="UserName" type="text" class="form-control">
            <span asp-validation-for="UserName" id="emailHelp" class="form-text"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control">
            <span asp-validation-for="Email" id="emailHelp" class="form-text"></span>
        </div>
        
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" type="password" class="form-control">
            <span asp-validation-for="Password" id="emailHelp" class="form-text"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-control">
            <span asp-validation-for="ConfirmPassword" id="emailHelp" class="form-text"></span>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>

